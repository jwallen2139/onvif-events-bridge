# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- MQTT credentials (referenced as ${VAR} from config.yaml) ---
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=changeme

# --- LAN / macvlan placement for the virtual camera ---------------------------
# docker-compose.yml needs these before any container starts.
#
# The camera gets its own IP+MAC on your LAN because UniFi Protect adopts it as a
# distinct device. The mqtt-bridge gets one too, because a Docker host (and any
# bridge-network container) cannot reach its own macvlan children.

MACVLAN_PARENT=eth0             # host NIC on your LAN (eth0, ens18, bond0, ...)
LAN_SUBNET=192.0.2.0/24         # your LAN subnet
LAN_GATEWAY=192.0.2.1           # your LAN gateway

CAMERA_IP=192.0.2.10            # free LAN IP for the camera (= onvif.host in config.yaml)
BRIDGE_IP=192.0.2.11            # free LAN IP for the mqtt-bridge
CAMERA_MAC=02:42:c0:a8:01:0a    # any locally-administered MAC, unique on your LAN

# --- Optional ONVIF tuning ----------------------------------------------------
# ONVIF_MOTION_TOPIC=tns1:RuleEngine/CellMotionDetector/Motion
# ONVIF_SUB_TIMEOUT_SECS=60
